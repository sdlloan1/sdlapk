{
  "previewPort": 3000,
  "healthPath": "/",
  "startCommand": "docker compose -f docker-compose.base44.yml up -d",
  "secrets": [
    {
      "name": "SESSION_SECRET",
      "description": "Signs dashboard login sessions.",
      "requiredAtBoot": true,
      "generatedForDevelopment": true
    },
    {
      "name": "ADMIN_PASSWORD",
      "description": "Password for the admin dashboard sign-in. Set by the app owner; replaces the development placeholder.",
      "requiredAtBoot": false
    }
  ]
}
