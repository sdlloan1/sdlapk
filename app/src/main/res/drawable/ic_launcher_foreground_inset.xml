<?xml version="1.0" encoding="utf-8"?>
<!-- The artwork is a full-bleed tile, so it is inset into the adaptive icon's safe zone;
     without it the launcher mask crops the outer part of the logo. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@mipmap/ic_launcher_foreground"
    android:insetLeft="19%"
    android:insetTop="19%"
    android:insetRight="19%"
    android:insetBottom="19%" />
