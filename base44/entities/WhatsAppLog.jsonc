{
  "name": "WhatsAppLog",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "user_mobile": {
      "type": "string"
    },
    "loan_id": {
      "type": "string"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "kyc_approved",
        "limit_increased",
        "loan_disbursed",
        "repayment_verified",
        "loan_rejected",
        "repayment_reminder"
      ]
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "message_type",
    "message"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}