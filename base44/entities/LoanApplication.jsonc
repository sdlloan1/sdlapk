{
  "name": "LoanApplication",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "user_mobile": {
      "type": "string"
    },
    "user_upi_id": {
      "type": "string"
    },
    "loan_id": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "interest_amount": {
      "type": "number"
    },
    "repayment_amount": {
      "type": "number"
    },
    "original_repayment_amount": {
      "type": "number",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "waiver_amount": {
      "type": "number",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "overdue_waived": {
      "type": "boolean",
      "default": false,
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_disbursement",
        "disbursed",
        "pending_verification",
        "repaid",
        "overdue",
        "rejected"
      ],
      "default": "pending_disbursement"
    },
    "agreement_pdf_url": {
      "type": "string"
    },
    "disbursement_screenshot": {
      "type": "string",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "call_recording_url": {
      "type": "string",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "additional_files": {
      "type": "string",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "repayment_screenshot": {
      "type": "string"
    },
    "repayment_screenshots": {
      "type": "string"
    },
    "admin_rejection_reason": {
      "type": "string",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "disbursed_date": {
      "type": "string",
      "format": "date-time",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "repaid_date": {
      "type": "string",
      "format": "date-time",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "overdue_days": {
      "type": "number",
      "default": 0,
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "referrer_earning_credited": {
      "type": "boolean",
      "default": false,
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "referrer_id": {
      "type": "string",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "user_id",
    "amount",
    "repayment_amount",
    "due_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}",
          "data.status": "pending_disbursement"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}