{
  "name": "AppDownload",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "enum": [
        "android",
        "ios",
        "pwa"
      ],
      "enumColors": [
        "green",
        "blue",
        "purple"
      ],
      "default": "android"
    },
    "source": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "referrer": {
      "type": "string"
    },
    "user_agent": {
      "type": "string"
    }
  },
  "required": [
    "platform"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
