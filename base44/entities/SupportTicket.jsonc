{
  "name": "SupportTicket",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "user_mobile": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "screenshot_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "responded",
        "closed"
      ],
      "default": "open"
    },
    "admin_response": {
      "type": "string"
    },
    "conversation": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "message"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}