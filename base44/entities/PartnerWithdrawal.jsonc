{
  "name": "PartnerWithdrawal",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "user_upi_id": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "withdrawal_type": {
      "type": "string",
      "enum": [
        "capital",
        "profit"
      ],
      "default": "profit"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "rejection_reason": {
      "type": "string"
    },
    "paid_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "amount",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.user_id": "{{user.id}}"
            },
            {
              "data.status": "pending"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}